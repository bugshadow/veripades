# ==========================================
# Configuration Environnement POC Signature
# ==========================================

# 1. Base de donnees PostgreSQL
DB_USER=postgres
DB_PASSWORD=motdepassefort
DB_NAME=poc_signature
# Format complet attendu : postgres://user:password@db:5432/nom_base
DATABASE_URL=postgres://postgres:motdepassefort@db:5432/poc_signature

# 2. Securite Node.js
# Generer une valeur longue et aleatoire avant tout deploiement partage.
JWT_SECRET=super-secret-key-2026-poc-dgssi

# 3. Microservice cryptographique
# Valeur de TEST uniquement pour le POC local, jamais a reutiliser en production.
PKI_PASSPHRASE='7h#K9$mP2@vL5xQ!'

# 4. URLs des services
PORT=3000
CRYPTO_SERVICE_URL=http://crypto:8000
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api
PDF_STORAGE_DIR=/app/storage

